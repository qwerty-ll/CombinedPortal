# Server Settings
PORT=8000
SECRET_KEY=your_super_secret_jwt_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
VERIFY_SSL=true

# Database Connection (SQLite local, PostgreSQL on VM)
DATABASE_URL=sqlite:///./portal.db
# PostgreSQL example for KSU VM:
# DATABASE_URL=postgresql://ivitsh_user:secret_password@localhost:5432/ivitsh_portal

# Sberbank GigaChat API Credentials
GIGACHAT_CLIENT_ID=your_gigachat_client_id_here
GIGACHAT_SECRET=your_gigachat_secret_here
