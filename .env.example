# =====================================================================
# ПОРТАЛ ИВИТШ КГУ — ПЕРЕМЕННЫЕ ОКРУЖЕНИЯ (ENVIRONMENT CONFIGURATION)
# Скопируйте этот файл в .env перед запуском: cp .env.example .env
# Официальный домен портала: https://ivitsh-portal.kosgos.ru
# =====================================================================

# 1. Автономная база данных SQLite WAL (или PostgreSQL)
DATABASE_URL=sqlite:///./portal.db

# 2. Безопасность и JWT Токены
SECRET_KEY=your_super_secret_jwt_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
VERIFY_SSL=true
# Set to false for local HTTP dev; must be true in HTTPS production
COOKIE_SECURE=true
DOCS_ENABLED=true

# 3. Интеграция с GigaChat API (ИИ-Чатбот ВИТШик)
GIGACHAT_CLIENT_ID=your_gigachat_client_id_here
GIGACHAT_SECRET=your_gigachat_secret_here

# 4. Учетные данные Главного Администратора Деканата ИВИТШ (НЕ ИСПОЛЬЗУЙТЕ ДЕФОЛТЫ В ПРОДЕ!)
ADMIN_USERNAME=your_custom_admin_username
ADMIN_PASSWORD=your_secure_admin_password_here

# 5. Разрешенные CORS домены (через запятую)
ALLOWED_ORIGINS=https://ivitsh-portal.kosgos.ru,http://localhost:5173,http://localhost:3000,https://combined-portal-freshman.vercel.app

# 6. Опциональный URL Бэкенда для Фронтенда
VITE_API_URL=
